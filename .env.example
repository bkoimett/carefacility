# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/care_facility

# Server Configuration
PORT=5000
NODE_ENV=development

# --- CLIENT URL (Vercel) ---
# Development (local): http://localhost:5173
# Production (Vercel): https://your-domain.vercel.app
CLIENT_URL=http://localhost:5173

# --- JWT Configuration ---
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Alert Cron Schedule ---
# Runs daily at midnight to generate overdue balance alerts
ALERT_CRON=0 0 * * *

# ------------------------------------------------------------------------------
# FOR PRODUCTION DEPLOYMENT (Render + Vercel)
# ------------------------------------------------------------------------------
# 1. On Render (Server):
#    - MONGODB_URI: your MongoDB Atlas connection string
#    - CLIENT_URL: https://your-domain.vercel.app
#    - JWT_SECRET: strong_secret_key (min 32 chars)
#    - NODE_ENV: production
#
# 2. On Vercel (Client):
#    - VITE_API_URL: https://your-render-backend.onrender.com (NO trailing slash, NO /api)
#      Example: https://carefacility-backend.onrender.com
#
# IMPORTANT: VITE_API_URL must match your Render backend URL exactly.
# Do NOT include /api or trailing slash.
# ------------------------------------------------------------------------------